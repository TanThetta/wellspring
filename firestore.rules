rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Database owner email check for monitoring access
    function isDbOwner() {
      return isSignedIn() && request.auth.token.email == 'harinipalanivel8@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isDbOwner();
      allow list: if isDbOwner();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isDbOwner();
    }

    // Diaries collection
    match /diaries/{diaryId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isDbOwner());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isDbOwner());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isDbOwner());
    }

    // Chat messages collection
    match /chat_messages/{messageId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isDbOwner());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isDbOwner());
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.text is string;
      allow update: if false;
      allow delete: if isSignedIn()
                    && (resource.data.userId == request.auth.uid || isDbOwner());
    }

    // Assessment records collection
    match /assessments/{assessmentId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isDbOwner());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isDbOwner());
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.score is number;
      allow update: if false;
      allow delete: if isSignedIn()
                    && (resource.data.userId == request.auth.uid || isDbOwner());
    }
  }
}
